YOUTUBE_API_KEY=
PORT=8788
HOST=127.0.0.1
# Set a stable random value in production (at least 32 characters).
DOWNLOAD_SIGNING_SECRET=
# Set after you have chosen the real public domain. No trailing slash.
PUBLIC_ORIGIN=
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Independent YT PFP accounts. Never reuse Typeflow database or secrets.
ACCOUNT_ORIGIN=https://ytpfp.com
BETTER_AUTH_SECRET=
DATABASE_URL=
DIRECT_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YT PFP <accounts@ytpfp.com>
# Local only: ACCOUNT_ORIGIN=http://127.0.0.1:8788 and AUTH_DEV_MODE=true
