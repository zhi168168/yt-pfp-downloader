{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/profile.mjs": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/image.mjs": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/health.mjs": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/account.mjs": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/billing.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.launchvault.dev https://auraplusplus.com https://www.outdr.lol https://saasgrow.app https://startuptrusted.com https://twelve.tools https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/account", "has": [{ "type": "host", "value": "(?<deployment>.+)\\.vercel\\.app" }], "destination": "https://www.ytpfp.com/account", "statusCode": 307 },
    { "source": "/account.html", "has": [{ "type": "host", "value": "(?<deployment>.+)\\.vercel\\.app" }], "destination": "https://www.ytpfp.com/account", "statusCode": 307 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "ytpfp.com" }], "destination": "https://www.ytpfp.com/:path*", "statusCode": 308 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "/api/billing?__billingPath=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/account?__authPath=:path*"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    }
  ]
}
